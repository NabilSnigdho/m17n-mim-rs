    ("rZ" (cond ((& (= PT ?c) (! (= P ?r)) (! (= P ?y)) (! (= P ?w)) (! (= P ?x))) "্র্য") (1 "র‍্য")) (set P ?Z) (set PT ?c))
    ("ry" (cond ((& (= PT ?c) (! (= P ?r)) (! (= P ?y)) (! (= P ?w)) (! (= P ?x))) "্র্য") (1 "র‍্য")) (set P ?y) (set PT ?c))
