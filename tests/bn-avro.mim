    ("o" (cond ((& (= PT ?v) (! (= P ?o))) "ও") ((& (= PT ?v) (= P ?o)) "অ") ((= PT '') "অ") (1 "")) (set P ?o) (set PT ?v))
    ("aZ" "অ্যা" (set P ?Z) (set PT ?c))
    ("AZ" "অ্যা" (set P ?Z) (set PT ?c))
    ("a" (cond ((& (= PT '') (! (= @+1 ?`))) "আ") ((& (! (= PT ?c)) (! (= P ?a)) (! (= @+1 ?`))) "য়া") ((& (= P ?a) (! (= @+1 ?`))) "আ") (1 "া")) (set P ?a) (set PT ?v))
    ("Z" "্য" (set P ?Z) (set PT ?c))
    ("y" (cond ((& (! (= PT ?c)) (! (= PT ''))) "য়") ((= PT '') "ইয়") (1 "্য")) (set P ?y) (set PT ?c))
    ("w" (cond ((& (= PT '') (| (= @+1 ?a) (= @+1 ?e) (= @+1 ?i) (= @+1 ?o) (= @+1 ?u) (= @+1 ?A) (= @+1 ?E) (= @+1 ?I) (= @+1 ?O) (= @+1 ?U))) "ওয়") ((= PT ?c) "্ব") (1 "ও")) (set P ?w) (set PT ?c))
    ("x" (cond ((= PT '') "এক্স") (1 "ক্স")) (set P ?x) (set PT ?c))
